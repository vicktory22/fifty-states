    "three": "^0.185.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
